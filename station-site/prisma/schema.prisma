generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  name            String @unique 
  email            String?   @unique
  password         String?
  role             String    @default("reader")
  avatar           String?
  profileImage     String?
  bio              String?
  subtitle         String?
  fullBio          String?
  contacts         Json?

  createdAt        DateTime  @default(now()) @map("created_at")

  articles         Article[] 
  comments         Comment[] 
  
  favorites        Favorite[] 
  
  @@map("users")
}

model Favorite {
  userId           String
  articleId        String
  createdAt        DateTime @default(now())
  
  user             User     @relation(fields: [userId], references: [id])
  article          Article  @relation(fields: [articleId], references: [id])

  @@id([userId, articleId]) 
  @@map("user_favorites")
}

model Article {
  id               String    @id @default(cuid())
  title            String
  content          String[]  
  img              String?
  heroImage        String?
  excerpt          String[]  
  category         String?
  categorySlug     String?
  time             String?
  
  isStream         Boolean   @default(false)
  youtubeId        String?
  
  authorId         String
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  
  author           User      @relation(fields: [authorId], references: [id])
  comments         Comment[]
  
  favorites        Favorite[] 

  @@map("articles")
}


model Comment {
  id            String   @id @default(cuid())
  text          String
  articleId     String
  authorId      String?   
  authorName    String?   
  createdAt     DateTime @default(now())
  
  article       Article @relation(fields: [articleId], references: [id])
  author        User?   @relation(fields: [authorId], references: [id]) 

  @@map("comments")
}